# cPanel MCP Server - Environment Configuration
# Designed by AkashJamali

# Required: Your cPanel username
CPANEL_USERNAME=your_cpanel_username

# Required: API Token generated from cPanel > Security > Manage API Tokens
CPANEL_API_TOKEN=your_cpanel_api_token

# Required: Full URL to your cPanel server (usually on port 2083 with HTTPS)
# Examples:
#   https://example.com:2083
#   https://cpanel.example.com:2083
#   https://server123.hostingprovider.com:2083
CPANEL_SERVER_URL=https://your-domain.com:2083

# Optional: Set to false if your server uses a self-signed SSL certificate
CPANEL_VERIFY_SSL=true

# Optional: Request timeout in milliseconds (default: 30000 = 30 seconds)
CPANEL_TIMEOUT_MS=30000

# Optional: Allow plain HTTP for localhost / 127.0.0.1 development only (default: false)
CPANEL_ALLOW_INSECURE_HTTP=false
